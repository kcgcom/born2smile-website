# 카카오맵 JavaScript 앱 키
# https://developers.kakao.com 에서 발급
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=your_kakao_map_app_key_here

# Supabase (DB + Auth)
# https://supabase.com/dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# 관리자 대시보드 접근 허용 이메일 (쉼표 구분)
ADMIN_EMAILS=kcgcom@gmail.com
ADMIN_CONTENT_EMAILS=
ADMIN_STAFF_EMAILS=
# 로컬 CLI의 관리자 API 인증용. 서버 설정과 같은 값이며 브라우저에 노출하지 않습니다.
ADMIN_CLI_SECRET=
# 에이전트 콘텐츠 조회·작업 제안/보고·비공개 원고/수정안 생성·이미지 업로드용. ADMIN_CLI_SECRET과 달라야 합니다.
AGENT_CONTENT_SECRET=

# GA4 / Search Console
GA4_PROPERTY_ID=525397980
SEARCH_CONSOLE_SITE_URL=sc-domain:born2smile.co.kr
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}
# Vercel OIDC / Google Workload Identity Federation (사용 시 다섯 값 모두 설정)
GCP_PROJECT_ID=
GCP_PROJECT_NUMBER=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
GCP_SERVICE_ACCOUNT_EMAIL=

# Google Business Profile Performance API (선택, 서버 전용)
GOOGLE_BUSINESS_PROFILE_LOCATION_ID=
GOOGLE_BUSINESS_PROFILE_CLIENT_ID=
GOOGLE_BUSINESS_PROFILE_CLIENT_SECRET=
GOOGLE_BUSINESS_PROFILE_REFRESH_TOKEN=

# 네이버 DataLab API
NAVER_DATALAB_CLIENT_ID=your_naver_client_id_here
NAVER_DATALAB_CLIENT_SECRET=your_naver_client_secret_here

# 네이버 검색광고 API (절대 검색량)
NAVER_SEARCHAD_API_KEY=
NAVER_SEARCHAD_SECRET_KEY=
NAVER_SEARCHAD_CUSTOMER_ID=

# PageSpeed Insights API
PAGESPEED_API_KEY=your_pagespeed_api_key_here
CRUX_API_KEY=

# Gemini Embedding API (검색성과 키워드 클러스터링)
GEMINI_API_KEY=

# 진료시간 장애 대비 사본 (서버 전용)
SITE_HOURS_GLOBAL_CONFIG=
GLOBAL_CONFIG=
SITE_HOURS_GLOBAL_CONFIG_TEAM_ID=
SITE_HOURS_GLOBAL_CONFIG_WRITE_TOKEN=

# Vercel Cron + IndexNow
CRON_SECRET=your_random_cron_secret_here
DATABASE_WEBHOOK_SECRET=your_separate_random_webhook_secret_here
INDEXNOW_KEY=

# Sentry (에러 모니터링)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_ENVIRONMENT=production
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# PostHog (전환/CTA 리포트)
NEXT_PUBLIC_POSTHOG_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://x.born2smile.co.kr
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com
POSTHOG_PROJECT_ID=
POSTHOG_API_KEY=
POSTHOG_BASE_URL=https://us.posthog.com
